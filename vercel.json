{
    "rewrites": [
        {
            "source": "/sitemap.xml",
            "destination": "/api/sitemap"
        },
        {
            "source": "/(index.html)?",
            "has": [
                {
                    "type": "header",
                    "key": "user-agent",
                    "value": "(.*googlebot|.*bingbot|.*facebookexternalhit|.*whatsapp|.*linkedinbot|.*twitterbot.*)"
                }
            ],
            "destination": "/api/seo?path=/"
        },
        {
            "source": "/product/:slug",
            "has": [
                {
                    "type": "header",
                    "key": "user-agent",
                    "value": "(.*googlebot|.*bingbot|.*facebookexternalhit|.*whatsapp|.*linkedinbot|.*twitterbot.*)"
                }
            ],
            "destination": "/api/seo?path=/product/:slug"
        },
        {
            "source": "/resin-products",
            "has": [
                {
                    "type": "header",
                    "key": "user-agent",
                    "value": "(.*googlebot|.*bingbot|.*facebookexternalhit|.*whatsapp|.*linkedinbot|.*twitterbot.*)"
                }
            ],
            "destination": "/api/seo?path=/resin-products"
        },
        {
            "source": "/festival",
            "has": [
                {
                    "type": "header",
                    "key": "user-agent",
                    "value": "(.*googlebot|.*bingbot|.*facebookexternalhit|.*whatsapp|.*linkedinbot|.*twitterbot.*)"
                }
            ],
            "destination": "/api/seo?path=/festival"
        },
        {
            "source": "/(.*)",
            "destination": "/"
        }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "Access-Control-Allow-Origin",
                    "value": "*"
                },
                {
                    "key": "Access-Control-Allow-Credentials",
                    "value": "true"
                },
                {
                    "key": "Access-Control-Allow-Headers",
                    "value": "X-CSRF-Token, X-Requested-With, Accept, Accept-Version, Content-Length, Content-MD5, Content-Type, Date, X-Api-Version"
                }
            ]
        }
    ]
}